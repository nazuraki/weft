{
	"private": true,
	"type": "module",
	"scripts": {
		"build": "pnpm -r run build",
		"test": "pnpm -r run test",
		"typecheck": "pnpm -r run typecheck",
		"lint": "biome check .",
		"fix": "biome check . --write",
		"dev": "pnpm --filter @lepid-labs/weft-core --filter @lepid-labs/weft build && weft serve . --dev"
	},
	"devDependencies": {
		"@biomejs/biome": "^1.9.4",
		"@lepid-labs/weft": "workspace:*"
	},
	"engines": {
		"node": ">=24"
	}
}
