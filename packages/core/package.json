{
	"name": "@lepid-labs/weft-core",
	"version": "0.1.0",
	"description": "Weft's document graph: indexing, links, validation and search over a docs tree",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Lepid-Labs/weft.git",
		"directory": "packages/core"
	},
	"homepage": "https://github.com/Lepid-Labs/weft#readme",
	"type": "module",
	"files": ["dist"],
	"main": "dist/index.js",
	"types": "src/index.ts",
	"exports": {
		".": {
			"types": "./src/index.ts",
			"default": "./dist/index.js"
		},
		"./browser": {
			"import": "./dist/browser.js",
			"types": "./src/browser.ts"
		}
	},
	"scripts": {
		"build": "tsc",
		"prepublishOnly": "pnpm run build",
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"test:watch": "vitest"
	},
	"dependencies": {
		"chokidar": "^4.0.0",
		"github-slugger": "^2.0.0",
		"glob": "^11.0.0",
		"mdast-util-to-string": "^4.0.0",
		"minisearch": "^7.0.0",
		"remark-parse": "^11.0.0",
		"unified": "^11.0.0",
		"unist-util-visit": "^5.0.0",
		"yaml": "^2.6.0"
	},
	"devDependencies": {
		"@types/mdast": "^4.0.0",
		"@types/node": "^22.0.0",
		"typescript": "^5.7.0",
		"vitest": "^3.2.6"
	},
	"publishConfig": {
		"access": "public",
		"types": "dist/index.d.ts",
		"exports": {
			".": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.js"
			},
			"./browser": {
				"types": "./dist/browser.d.ts",
				"import": "./dist/browser.js"
			}
		}
	}
}
