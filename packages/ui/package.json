{
	"name": "@lepid-labs/weft-ui",
	"version": "0.1.0",
	"description": "Weft's browser UI, prebuilt for the CLI to serve",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Lepid-Labs/weft.git",
		"directory": "packages/ui"
	},
	"homepage": "https://github.com/Lepid-Labs/weft#readme",
	"type": "module",
	"files": ["build"],
	"exports": {
		"./handler": "./build/handler.js",
		"./package.json": "./package.json"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"prepublishOnly": "pnpm run build",
		"preview": "vite preview",
		"typecheck": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"test": "vitest run --passWithNoTests",
		"test:watch": "vitest"
	},
	"dependencies": {
		"@nazuraki/styles": "^0.3.0",
		"@lepid-labs/weft-core": "workspace:*",
		"rehype-highlight": "^7.0.2",
		"rehype-raw": "^7.0.0",
		"rehype-sanitize": "^6.0.0",
		"rehype-slug": "^6.0.0",
		"rehype-stringify": "^10.0.0",
		"remark-gfm": "^4.0.1",
		"remark-parse": "^11.0.0",
		"remark-rehype": "^11.0.0",
		"unified": "^11.0.0",
		"unist-util-visit": "^5.1.0",
		"vfile": "^6.0.3"
	},
	"devDependencies": {
		"@sveltejs/adapter-node": "^5.0.0",
		"@sveltejs/kit": "^2.70.2",
		"@sveltejs/vite-plugin-svelte": "^5.0.0",
		"@types/hast": "^3.0.5",
		"@types/node": "^22.0.0",
		"svelte": "^5.56.10",
		"svelte-check": "^4.0.0",
		"typescript": "^5.7.0",
		"vite": "^6.4.3",
		"vitest": "^3.2.6"
	},
	"publishConfig": {
		"access": "public"
	}
}
